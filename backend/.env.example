NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/kavachai
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
HELMET_DEVICE_KEY=replace-with-a-long-random-device-secret
HELMET_DEVICE_USER_ID=
ADMIN_EMAIL_1=first-admin@example.com
ADMIN_PASSWORD_1=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_EMAIL_2=second-admin@example.com
ADMIN_PASSWORD_2=replace-with-a-different-password-of-at-least-12-characters